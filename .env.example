# Required
DISCORD_TOKEN=put_your_bot_token_here

# Basic bot settings
COMMAND_PREFIX=!
DATABASE_PATH=data/bot.db

# Requested default channels.
# Leave MUSIC_VOICE_CHANNEL_ID blank to allow music from any caller voice channel.
WELCOME_CHANNEL_ID=
MUSIC_VOICE_CHANNEL_ID=

# Optional feature channels. Leave blank to let the bot search by common names.
STARBOARD_CHANNEL_ID=
MOD_LOG_CHANNEL_ID=

# Optional feature tuning
STARBOARD_THRESHOLD=5
XP_PER_MESSAGE_MIN=8
XP_PER_MESSAGE_MAX=14
XP_COOLDOWN_SECONDS=60

# Temporary voice rooms:
# If TEMP_VOICE_LOBBY_ID is set, joining that voice channel auto-creates a room.
# Users can also run !temproom while connected to any voice channel.
TEMP_VOICE_LOBBY_ID=
TEMP_VOICE_CATEGORY_ID=

# Optional moderation
MUTED_ROLE_NAME=Muted

# Optional YouTube workaround.
# Leave blank normally. If YouTube blocks your VPS with 403 errors, export cookies
# from a browser and set this to the uploaded cookies.txt path.
YTDLP_COOKIES_FILE=

# Optional yt-dlp JavaScript challenge settings.
# Deno is recommended for modern YouTube signature/n-challenge solving.
YTDLP_JS_RUNTIMES=deno
# Usually blank when yt-dlp[default] is installed. If EJS scripts are missing, use:
# YTDLP_REMOTE_COMPONENTS=ejs:github
YTDLP_REMOTE_COMPONENTS=
